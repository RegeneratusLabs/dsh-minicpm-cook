{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/dsh-minicpm-cook/models.schema.json",
  "title": "MiniCPM cook model catalog",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "upstream", "licenses", "models"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "upstream": {
      "type": "object",
      "required": ["repo", "revision", "skillsPath", "docsPath", "cookbook", "wiki"],
      "additionalProperties": true,
      "properties": {
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "revision": { "type": "string", "minItems": 1 },
        "skillsPath": { "type": "string" },
        "docsPath": { "type": "string" },
        "cookbook": { "type": "string" },
        "wiki": { "type": "string", "pattern": "^https?://" },
        "vrlRepo": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "licenses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["redistributable", "commercialUse", "attributionRequired", "notes"],
        "additionalProperties": true,
        "properties": {
          "redistributable": { "type": "boolean" },
          "commercialUse": { "type": "boolean" },
          "attributionRequired": { "type": "boolean" },
          "notes": { "type": "string" },
          "sourceUrl": { "type": ["string", "null"] }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id", "displayName", "family", "modality", "paramsB", "architecture",
          "trustRemoteCode", "contextTokens", "hfId", "license", "licenseSourceUrl",
          "licenseVerified", "releaseDate", "chatTemplate", "bestFor", "frameworks",
          "variants", "sources", "confidence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "displayName": { "type": "string", "minItems": 1 },
          "family": {
            "type": "string",
            "enum": ["minicpm5", "minicpm41", "minicpm4", "sala", "minicpm-v", "minicpm-o", "ocr", "bitcpm", "legacy"]
          },
          "modality": { "type": "string", "enum": ["text", "vision", "omni", "ocr"] },
          "paramsB": { "type": "number", "minimum": 0.01 },
          "activeParamsB": { "type": "number", "minimum": 0.01 },
          "layers": { "type": "integer", "minimum": 1 },
          "hiddenSize": { "type": "integer", "minimum": 1 },
          "kvHeads": { "type": "integer", "minimum": 1 },
          "headDim": { "type": "integer", "minimum": 1 },
          "architecture": { "type": "string", "minItems": 1 },
          "trustRemoteCode": { "type": "boolean" },
          "contextTokens": { "type": "integer", "minimum": 512 },
          "extendedContextTokens": { "type": "integer", "minimum": 512 },
          "hfId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "msId": { "type": "string" },
          "license": { "type": "string", "minItems": 1 },
          "licenseSourceUrl": { "type": ["string", "null"] },
          "licenseVerified": { "type": "boolean" },
          "releaseDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "chatTemplate": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": true,
            "properties": { "name": { "type": "string" } }
          },
          "sampling": { "type": "object", "additionalProperties": true },
          "vision": { "type": "object", "additionalProperties": true },
          "bestFor": { "type": "string", "minItems": 1 },
          "frameworks": {
            "type": "object",
            "minItems": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "supported": { "type": "boolean" },
                "minVersion": { "type": "string" },
                "template": { "type": "string" },
                "modelType": { "type": "string" },
                "toolCallParser": { "type": "string" },
                "notes": { "type": "string" }
              }
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "hfId"],
              "additionalProperties": true,
              "properties": {
                "kind": { "type": "string" },
                "hfId": { "type": "string" },
                "notes": { "type": "string" }
              }
            }
          },
          "publishedHardware": { "type": "object", "additionalProperties": true },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https?://" } },
          "confidence": { "type": "string", "enum": ["verified", "unverified"] },
          "confidenceNote": { "type": "string" }
        }
      }
    }
  }
}
